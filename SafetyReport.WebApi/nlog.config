<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      internalLogFile="internal-nlog.txt"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
    <add assembly="SafetyReport.WebApi" />
  </extensions>

  <targets>
    <!-- Nivel configurable desde appsettings.json (Logging:LogLevel:Default), leído y
         aplicado a esta regla en Program.cs después de builder.Build() — el atributo
         minlevel de un <logger> no admite ${configsetting} porque no es un Layout. -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:uppercase=true}|${callsite}|${aspnet-user-identity}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <!-- Sube el .txt del día a S3 vía IS3UploadService (sin tocar disco). El servicio se
         inyecta desde Program.cs después de levantar el ServiceProvider (ver
         S3FallbackTarget.UploadService). Se ejecuta siempre, no depende de si el target
         "db" falla o no. -->
    <target xsi:type="S3Fallback" name="s3" />

    <!-- Inserta en dbo.LOGS a través de SP_Log_Insertar. Se ejecuta siempre, en paralelo
         e independiente del target "s3" — si este falla, no afecta a "s3" y viceversa. -->
    <target xsi:type="Database"
            name="db"
            dbProvider="MySqlConnector.MySqlConnection, MySqlConnector"
            connectionString="${configsetting:name=ConnectionStrings.DefaultConnection}"
            commandType="StoredProcedure"
            commandText="SP_Log_Insertar">
      <parameter name="@p_vchNivel" layout="${level:uppercase=true}" />
      <parameter name="@p_vchLogger" layout="${logger}" />
      <parameter name="@p_vchMensaje" layout="${message}" />
      <parameter name="@p_vchExcepcion" layout="${exception:format=tostring}" />
      <parameter name="@p_vchUsuario" layout="${aspnet-user-identity}" />
    </target>
  </targets>

  <rules>
    <!-- Warn incluye la rama "SP sin fila" y Error incluye las excepciones no controladas;
         ambas terminan en IdTipoMensaje = 3, así que las dos van al log. writeTo con los dos
         nombres separados por coma manda el evento a "db" y a "s3" por separado — no es un
         fallback, los dos se ejecutan siempre, independientemente del resultado del otro. -->
    <logger name="*" minlevel="Warn" writeTo="db,s3" />

    <!-- Nivel por defecto Warn; se sobreescribe en Program.cs con Logging:LogLevel:Default.
         ruleName permite ubicarla por RemoveRuleByName/AddRule en vez de por posición. -->
    <logger name="*" ruleName="console" minlevel="Warn" writeTo="console" />
  </rules>

</nlog>
