<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      internalLogFile="internal-nlog.txt"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
    <add assembly="SafetyReport.WebApi" />
  </extensions>

  <targets>
    <!-- Bkp: sube el .txt directo a S3 vía IS3UploadService (sin tocar disco).
         El servicio se inyecta desde Program.cs después de levantar el ServiceProvider
         (ver S3FallbackTarget.UploadService). -->
    <target xsi:type="S3Fallback" name="s3" />

    <!-- Primary: inserta en dbo.LOGS a través de SP_Log_Insertar. Si el INSERT tira excepción,
         NLog no la traga acá adentro (el SP tampoco la traga) — cae al bkp de S3. -->
    <target xsi:type="Database"
            name="db"
            dbProvider="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient"
            connectionString="${configsetting:name=ConnectionStrings.DefaultConnection}"
            commandType="StoredProcedure"
            commandText="dbo.SP_Log_Insertar">
      <parameter name="@vchNivel" layout="${level:uppercase=true}" />
      <parameter name="@vchLogger" layout="${logger}" />
      <parameter name="@vchMensaje" layout="${message}" />
      <parameter name="@vchExcepcion" layout="${exception:format=tostring}" />
      <parameter name="@vchUsuario" layout="${aspnet-user-identity}" />
    </target>

    <!-- primary: tabla de base de datos. bkp: s3 (en un .txt). -->
    <target xsi:type="FallbackGroup" name="primary" returnToFirstOnSuccess="true">
      <target-ref name="db" />
      <target-ref name="s3" />
    </target>
  </targets>

  <rules>
    <!-- Warn incluye la rama "SP sin fila" y Error incluye las excepciones no controladas;
         ambas terminan en IdTipoMensaje = 3, así que las dos van al log. -->
    <logger name="*" minlevel="Warn" writeTo="primary" />
  </rules>

</nlog>
